rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's private save (coins, pups, progress)
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard: anyone signed in can read; you only write your own row
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Live events (e.g. a global 2x/3x coin event) — only the admin may write
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'zortmanaidan@gmail.com';
    }
  }
}
